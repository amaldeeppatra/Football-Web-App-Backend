<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laliga</title>
    <style>
        body, h1, form, label, input, button {
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    box-sizing: border-box;
}

body {
    background-color: #f9f9fb;
    color: #333;
    padding: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
}

h1 {
    font-size: 2.5em;
    color: #4a90e2;
    margin-bottom: 20px;
}

form {
    background-color: white;
    border-radius: 10px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    padding: 30px;
    width: 90%;
    max-width: 400px;
}

label {
    font-size: 1.2em;
    color: #555;
    margin-bottom: 10px;
    display: block;
    text-align: left;
}

input[type="file"] {
    width: 100%;
    margin: 15px 0;
    padding: 10px;
    border: 2px solid #ccc;
    border-radius: 5px;
    outline: none;
    font-size: 1em;
    transition: border-color 0.3s;
}

input[type="file"]:focus {
    border-color: #4a90e2;
}

button {
    background-color: #4a90e2;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 10px 20px;
    font-size: 1em;
    cursor: pointer;
    width: 100%;
    transition: background-color 0.3s, transform 0.2s;
    margin-top: 10px;
}

button:hover {
    background-color: #357ab7;
    transform: scale(1.03);
}

button:active {
    transform: scale(1);
}

@media (max-width: 768px) {
    form {
        padding: 20px;
    }

    h1 {
        font-size: 2em;
    }

    label {
        font-size: 1em;
    }

    input[type="file"],
    button {
        font-size: 1em;
    }
}

    </style>
</head>
<body>
    <h1>Laliga</h1>
    <form action="/data/laliga" method="post" enctype="multipart/form-data">
        <label for="">Upload the Excel sheet</label>
        <br>
        <input type="file" name="file" id="">
        <button>Submit</button>
    </form>
</body>
</html>